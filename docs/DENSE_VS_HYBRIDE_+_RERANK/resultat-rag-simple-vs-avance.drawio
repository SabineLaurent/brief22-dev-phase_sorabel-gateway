                <mxCell id="config" value="Les deux configurations comparées&#xa;&#xa;RAG simple : RAG dense, sans reranker&#xa;RAG avancé : RAG hybride, avec reranker" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="40" y="248" width="820" height="100" as="geometry"/>
                </mxCell>

                <mxCell id="def-hit" value="Hit@1&#xa;&#xa;« Le bon document sort-il en PREMIÈRE position ? »&#xa;&#xa;Une question compte pour 1 si le document attendu est&#xa;au rang 1, pour 0 sinon. Métrique binaire et sévère :&#xa;un document au rang 2 vaut zéro, comme un document&#xa;absent. Elle dit si la recherche est JUSTE.&#xa;&#xa;Dénominateur : 8 questions par référence exacte." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="366" width="400" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="def-recall" value="Recall@5&#xa;&#xa;« Le bon document est-il QUELQUE PART dans les&#xa;5 résultats rendus ? »&#xa;&#xa;Le rang ne compte plus, seule la présence. Le « 5 »&#xa;est search_top_k : au-delà, aucun rang n'est noté.&#xa;Elle dit si la recherche est SUFFISANTE.&#xa;&#xa;Dénominateur : 13 questions couvertes." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="460" y="366" width="400" height="200" as="geometry"/>
                </mxCell>

                <mxCell id="note" value="Les deux colonnes ne portent pas sur les mêmes questions : elles ne se comparent pas ligne à ligne.&#xa;Un bon Recall@5 avec un Hit@1 nul signifie « le document est là, mais noyé » — c'est ce que le reranker répare en réordonnant." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="40" y="584" width="820" height="50" as="geometry"/>
                </mxCell>
