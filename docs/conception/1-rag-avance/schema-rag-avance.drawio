                <mxCell id="N_SONDE" value="&lt;b&gt;Ce que la sonde du corpus a supprimé&lt;/b&gt;&lt;br&gt;&lt;br&gt;· &lt;b&gt;pas de chunking&lt;/b&gt; — document le plus long :&lt;br&gt;&amp;nbsp;&amp;nbsp; 923 caractères ≈ 230 tokens, fenêtre 512&lt;br&gt;· &lt;b&gt;pas de normalisation Markdown&lt;/b&gt; — aucun tableau&lt;br&gt;&amp;nbsp;&amp;nbsp; dans les 400 documents&lt;br&gt;· &lt;b&gt;pas de Docling ni de PyTorch&lt;/b&gt; — PDF de 1,5 Ko,&lt;br&gt;&amp;nbsp;&amp;nbsp; une page, une police, générés par script&lt;br&gt;· &lt;b&gt;pas de dédoublonnage strict&lt;/b&gt; — zéro hash d’octets&lt;br&gt;&amp;nbsp;&amp;nbsp; dupliqué ; le vrai risque est la ré-ingestion, d’où upsert" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fontColor=#444444;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="1075" y="220" width="300" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="N_REGLES" value="&lt;b&gt;Tout est indexé — les quatre règles de version&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;R1&lt;/b&gt; filtre après la fusion, avant le rerank ;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; k_interne élargi car les périmés prennent des places&lt;br&gt;&lt;b&gt;R2&lt;/b&gt; tout document rendu déclare son obsolescence&lt;br&gt;&lt;b&gt;R3&lt;/b&gt; l’historique est demandé, jamais subi —&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; le défaut est le comportement sûr&lt;br&gt;&lt;b&gt;R4&lt;/b&gt; une édition périmée ne fait jamais autorité seule :&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; l’édition courante de sa famille est jointe&lt;br&gt;&lt;br&gt;&lt;i&gt;Invariant à tester : sur les 50 familles à deux versions,&lt;br&gt;une recherche par référence ne rend jamais la v1.0 par défaut.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fontColor=#444444;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="845" y="790" width="380" height="245" as="geometry"/>
                </mxCell>
                <mxCell id="N_CHUNK" value="&lt;b&gt;Un document = un chunk&lt;/b&gt;&lt;br&gt;&lt;br&gt;le document retrouvé porte toujours son titre, sa référence,&lt;br&gt;sa version et sa date : la citation E1 ne peut pas être&lt;br&gt;incomplète, et un refus ne peut pas venir d’un découpage&lt;br&gt;malheureux." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fontColor=#444444;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="1075" y="440" width="300" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="N_BARR" value="&lt;b&gt;Deux barrières, pas une&lt;/b&gt;&lt;br&gt;&lt;br&gt;le seuil est déterministe mais aveugle au contenu ;&lt;br&gt;la garde de suffisance lit le contenu mais reste&lt;br&gt;probabiliste. Chacune couvre le défaut de l’autre." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fontColor=#444444;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="680" y="1690" width="330" height="120" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
