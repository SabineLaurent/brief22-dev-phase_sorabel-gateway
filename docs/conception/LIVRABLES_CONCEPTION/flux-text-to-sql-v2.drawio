                    </mxGeometry>
                </mxCell>
                <mxCell id="jp" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#999999;endArrow=open;jettySize=20;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="70" y="1605"/>
                        </Array>
                        <mxPoint x="70" y="1421.25" as="sourcePoint"/>
                        <mxPoint x="405" y="1605" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="REC" value="&lt;b&gt;Les quatre tools, et le chemin que chacun emprunte&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;ask_database&lt;/b&gt;(question) &lt;i&gt;génératif&lt;/i&gt; &amp;#8594; N1 · N2 · N3 · N4 · N5 · N6 · N7 · &lt;b&gt;S1&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;le seul qui produise du SQL, donc le seul qui ait besoin de N3 et N4&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;get_schema&lt;/b&gt;() &lt;i&gt;aide&lt;/i&gt; &amp;#8594; N1 · N2 · &lt;b&gt;S2&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;s&amp;#x27;arrête au contrat de lecture : un client peut vouloir composer sa question sans rien déclencher&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;check_stock&lt;/b&gt;(ref) &amp;nbsp;·&amp;nbsp; &lt;b&gt;order_status&lt;/b&gt;(order_id) &lt;i&gt;figés&lt;/i&gt; &amp;#8594; N1 · N6 · N7 · &lt;b&gt;S1&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;leur requête est écrite d&amp;#x27;avance : ni schéma à fournir, ni modèle à appeler, ni requête à valider&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Les quatre passent par N1 et aboutissent à J.&lt;/b&gt; Ce qui change d&amp;#x27;un tool à l&amp;#x27;autre, c&amp;#x27;est &lt;i&gt;quand&lt;/i&gt;&lt;br/&gt;leur périmètre est vérifié — pas &lt;i&gt;s&amp;#x27;il&lt;/i&gt; l&amp;#x27;est." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#F7F7F7;align=left;spacingLeft=14;spacingRight=14;spacingTop=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="620" y="1730" width="530" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="TF" value="&lt;b&gt;Tools figés&lt;/b&gt;&lt;br&gt;&lt;i&gt;des requêtes écrites à l&#39;avance&lt;/i&gt;&lt;br&gt;check_stock(ref)&lt;br&gt;order_status(order_id)&lt;i&gt;&lt;br&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="16" y="120" width="350" height="72.5" as="geometry"/>
                </mxCell>
                <mxCell id="R0" value="&lt;b&gt;R0 · Refus&lt;/b&gt; tool_interdit&lt;br&gt;&lt;i&gt;ce profil n&#39;a pas droit à ce tool, ou le profil est absent, inconnu, mal typé : on ferme par défaut&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="865" y="292.5" width="310" height="69" as="geometry"/>
                </mxCell>
                <mxCell id="R1" value="&lt;b&gt;R1 · Refus&lt;/b&gt; hors_schema&lt;br/&gt;&lt;i&gt;la base ne contient pas cette donnée — aucune requête n&amp;#x27;est produite, ni tentée&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="865" y="577.5" width="310" height="69" as="geometry"/>
                </mxCell>
                <mxCell id="C1" value="&lt;b&gt;C1 · Clarification&lt;/b&gt;&lt;br/&gt;&lt;i&gt;on propose des choix fermés, limités à ce que ce profil a le droit de lire (filtrés par N1)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="865" y="706.5" width="310" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="R2" value="&lt;b&gt;R2 · Refus&lt;/b&gt; ecriture_refusee&lt;br/&gt;&lt;i&gt;déclenché par les contrôles 1 à 4&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="865" y="809.5" width="310" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="R3" value="&lt;b&gt;R3 · Refus&lt;/b&gt; perimetre_interdit&lt;br&gt;&lt;i&gt;contrôle 5 —&amp;gt; la colonne en cause sera nommée dans le journal&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="865" y="903.5" width="310" height="69" as="geometry"/>
                </mxCell>
                <mxCell id="A1" value="&lt;b&gt;A1 · Aucune ligne&lt;/b&gt;&lt;br/&gt;&lt;i&gt;ce n&amp;#x27;est ni un refus ni une erreur : la réponse est « rien ne correspond »&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="865" y="1240.5" width="310" height="69" as="geometry"/>
                </mxCell>
                <mxCell id="A2" value="&lt;b&gt;A2 · Des lignes se ressemblent&lt;/b&gt;&lt;br/&gt;&lt;i&gt;deux produits portent le même nom : on les rend toutes, chacune avec sa référence&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="865" y="1374.5" width="310" height="69" as="geometry"/>
                </mxCell>
                <mxCell id="a28" value="&lt;i&gt;tous les chemins&amp;nbsp; (servis, refusés, ou échoués)&lt;br&gt;aboutissent au journal&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="810" y="1606.5" width="300" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="G1" value="&lt;b&gt;Acronymes&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;MCP&lt;/b&gt; &lt;i&gt;(Model Context Protocol)&lt;/i&gt; — le protocole par lequel un serveur met ses outils à disposition de plusieurs clients : le bot du support, l&#39;éditeur de code des devs, le poste des commerciaux.&lt;br&gt;&lt;br&gt;&lt;b&gt;Profil&lt;/b&gt; — le rôle de celui qui appelle : &lt;i&gt;support&lt;/i&gt; ou &lt;i&gt;commercial&lt;/i&gt;. C&#39;est lui, et non la personne, qui décide de ce qui est lisible.&lt;br&gt;&lt;br&gt;&lt;b&gt;DDL&lt;/b&gt; &lt;i&gt;(Data Definition Language)&lt;/i&gt; — la partie du SQL qui décrit les tables (CREATE TABLE …). C&#39;est cette description du schéma qu&#39;on montre au modèle.&lt;br&gt;&lt;br&gt;&lt;b&gt;AST&lt;/b&gt; &lt;i&gt;(arbre syntaxique)&lt;/i&gt; — la requête vue comme une structure d&#39;instructions, et non comme une suite de caractères. Un mot d&#39;écriture dissimulé dans un commentaire ne trompe pas l&#39;arbre, alors qu&#39;il trompe une recherche de mots interdits.&lt;br&gt;&lt;br&gt;&lt;b&gt;WITH … AS (…)&lt;/b&gt; — une sous-requête à laquelle on donne un nom pour la réutiliser plus bas. Il faut l&#39;inspecter comme le reste : sans cela, une écriture peut s&#39;y loger sans être vue.&lt;br&gt;&lt;br&gt;&lt;b&gt;Alias&lt;/b&gt; — le surnom donné à une table dans la requête &lt;i&gt;(FROM produits p)&lt;/i&gt;. Tant qu&#39;il n&#39;est pas résolu, &lt;i&gt;p.marge_pct&lt;/i&gt; ne ressemble pas à une colonne interdite." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#F7F7F7;align=left;spacingLeft=14;spacingRight=14;spacingTop=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="70" y="1950" width="530" height="303" as="geometry"/>
                </mxCell>
                <mxCell id="G2" value="&lt;b&gt;Les verrous, et les repères venus du brief&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;mode=ro&lt;/b&gt; &lt;i&gt;(read-only)&lt;/i&gt; — la connexion est ouverte en lecture seule : par ce canal, le fichier de la base ne peut pas être modifié.&lt;br&gt;&lt;br&gt;&lt;b&gt;query_only=ON&lt;/b&gt; — un verrou interne au moteur SQLite, qui refuse toute écriture. Il double le précédent : deux verrous de nature différente, pour qu&#39;une seule faille ne suffise pas.&lt;br&gt;&lt;br&gt;&lt;b&gt;PRAGMA · ATTACH · VACUUM&lt;/b&gt; — des commandes SQLite qui ne lisent aucune donnée : elles règlent le moteur, ouvrent un second fichier de base, ou réorganisent le stockage. Aucune n&#39;a sa place dans une question métier.&lt;br&gt;&lt;br&gt;&lt;b&gt;LIMIT&lt;/b&gt; — le nombre maximal de lignes qu&#39;une requête a le droit de rendre.&lt;br&gt;&lt;br&gt;&lt;b&gt;E1 à E6&lt;/b&gt; — les six exigences imposées par la note de cadrage de la DSI. &lt;b&gt;E3&lt;/b&gt; : tout SQL exécuté est en lecture seule, et la requête est tracée. &lt;b&gt;E5&lt;/b&gt; : tout appel est journalisé, et ni les prix d&#39;achat ni les marges ne sortent pour le support.&lt;br&gt;&lt;br&gt;&lt;b&gt;T1 à T4&lt;/b&gt; — les quatre tests d&#39;acceptance du volet Text-to-SQL, fournis avec le brief &lt;i&gt;(bandeau du haut)&lt;/i&gt;." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#F7F7F7;align=left;spacingLeft=14;spacingRight=14;spacingTop=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="620" y="1950" width="530" height="303" as="geometry"/>
                </mxCell>
