<mxfile host="65bd71144e">
    <diagram name="Flux Text-to-SQL v2" id="flux-t2sql-v2">
        <mxGraphModel dx="1249" dy="3380" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1220" pageHeight="2434" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="BG" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;movable=1;resizable=1;deletable=1;editable=1;connectable=1;pointerEvents=0;rotatable=1;locked=0;strokeWidth=2;shadow=1;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="10" y="-148" width="1220" height="2440" as="geometry"/>
                </mxCell>
                <mxCell id="T1x" value="&lt;b&gt;Flux Text-to-SQL gouverné&lt;/b&gt;&amp;nbsp;-- Sorabel Data Gateway, chantier 2 - V2" style="text;html=1;align=left;verticalAlign=top;fontSize=18;" parent="1" vertex="1">
                    <mxGeometry x="15" y="-130" width="760" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="T2x" value="&lt;b&gt;Les quatre tests d&#39;acceptance fournis avec le brief&lt;/b&gt;, et l&#39;étape du schéma qui les&lt;div&gt;fait passer :&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;b&gt;T1&lt;/b&gt; le résultat est rendu avec la requête qui l&#39;a produit → &lt;b&gt;S1&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;T2&lt;/b&gt; une demande d&#39;écriture est refusée, et journalisée → &lt;b&gt;R2 + J&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;T3&lt;/b&gt; les marges sont refusées au profil support → &lt;b&gt;R3&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;T4&lt;/b&gt; une question hors schéma est refusée → &lt;b&gt;R1&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;shadow=0;glass=0;rounded=0;fillColor=none;strokeColor=#F7F7F7;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="70" y="1730" width="530" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="LGx" value="&lt;b&gt;Légendes&lt;br&gt;&lt;/b&gt;&lt;br&gt;Les lettres ne sont que des repères de lecture, elles n&#39;ont pas d&#39;autre sens :&lt;br&gt;&lt;b&gt;N&lt;/b&gt;&amp;nbsp;étape &lt;b&gt;nominale&lt;/b&gt; —&amp;gt; le cas normal, celui où rien ne dérape &amp;nbsp;&lt;i&gt;(bleu)&lt;/i&gt;&lt;br&gt;&lt;b&gt;R&lt;/b&gt;&amp;nbsp;&lt;b&gt;refus&lt;/b&gt; —&amp;gt; on s&#39;arrête là, aucune requête n&#39;est exécutée &amp;nbsp;&lt;i&gt;(rouge)&lt;/i&gt;&lt;br&gt;&lt;b&gt;C&amp;nbsp;&lt;/b&gt;demande de &lt;b&gt;clarification&lt;/b&gt; renvoyée au client &amp;nbsp;&lt;i&gt;(orange)&lt;/i&gt;&lt;br&gt;&lt;b&gt;A&lt;/b&gt; &lt;b&gt;autre sortie&lt;/b&gt; —&amp;gt; exécuté, mais inexploitable tel quel &amp;nbsp;&lt;i&gt;(orange)&lt;/i&gt;&lt;br&gt;&lt;b&gt;S&lt;/b&gt;&amp;nbsp;sortie réussie&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;b&gt;P &lt;/b&gt;probleme rencontré, le systeme a échoué&lt;br&gt;&lt;/font&gt;&lt;b&gt;J&lt;/b&gt;&amp;nbsp;journal &amp;nbsp;&lt;i&gt;(gris)&lt;br&gt;&lt;/i&gt;&lt;br&gt;&lt;i&gt;vert&lt;/i&gt;&amp;nbsp; barrière de gouvernance : elle a le pouvoir d&#39;arrêter la requête&lt;br&gt;&lt;b&gt;P&lt;/b&gt;&amp;nbsp;&lt;b&gt;panne&lt;/b&gt; —&amp;gt; ni refus ni résultat : la chaîne a échoué &amp;nbsp;&lt;i&gt;(bordure rouge, fond clair)&lt;/i&gt;&lt;br&gt;&lt;br&gt;Un &lt;b&gt;R&lt;/b&gt; dit non à l&#39;utilisateur ; un &lt;b&gt;P&lt;/b&gt; dit que nous n&#39;avons pas pu.&lt;br&gt;&lt;br&gt;trait plein = chemin nominal&lt;div&gt;tiret = sortie latérale&lt;br&gt;pointillet = problème rencontré.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;align=left;spacingLeft=14;spacingRight=14;spacingTop=8;verticalAlign=top;fontSize=11;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="850" y="-120" width="350" height="340" as="geometry"/>
                </mxCell>
                <mxCell id="IN" value="&lt;b&gt;ask_database&lt;/b&gt;(question) et&amp;nbsp;&lt;b&gt;get_schema&lt;/b&gt;()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="375" y="120" width="400" height="72.5" as="geometry"/>
                </mxCell>
                <mxCell id="N1" value="&lt;b&gt;N1 · Matrice d&#39;accès&lt;/b&gt;&lt;br&gt;&lt;i&gt;qui a le droit de lire quoi&lt;/i&gt; —&amp;gt; profil × table × colonne" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="375" y="244.5" width="400" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="N2" value="&lt;b&gt;N2 · Ce qu&amp;#x27;on donne au modèle&lt;/b&gt; &lt;i&gt;(c&amp;#x27;est le tool get_schema)&lt;/i&gt;&lt;br/&gt;· la description des tables (le &lt;b&gt;DDL&lt;/b&gt;), réduite aux colonnes que ce profil a le droit de lire&lt;br/&gt;· la liste des valeurs possibles de chaque colonne&lt;br/&gt;· la période réellement couverte par les données&lt;br/&gt;· les conventions métier &lt;i&gt;(ex. : montant_ht est un montant brut, avant remise)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="375" y="344.5" width="400" height="154" as="geometry"/>
                </mxCell>
                <mxCell id="S2" value="&lt;b&gt;S2 · get_schema s&#39;arrête ici&lt;/b&gt;&lt;br&gt;&lt;i&gt;il rend au profil son contrat de lecture —&amp;gt; DDL filtré, valeurs possibles, période, conventions. Aucun SQL n&#39;est généré&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="865" y="397.5" width="310" height="92" as="geometry"/>
                </mxCell>
                <mxCell id="N3" value="&lt;b&gt;N3 · Appel au modèle de langage&lt;/b&gt;&lt;br/&gt;&lt;i&gt;un seul appel, et la réponse doit avoir une forme imposée&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="375" y="546.5" width="400" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="D" value="&lt;b&gt;que renvoie&lt;br/&gt;le modèle ?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="485" y="646.5" width="180" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="N4" value="&lt;b&gt;N4 · Validation de la requête&lt;/b&gt;&lt;br&gt;&lt;i&gt;on n&#39;inspecte pas le texte de la requête mais sa structure — son arbre syntaxique, ou &lt;b&gt;AST&lt;/b&gt;. Cinq contrôles :&lt;/i&gt;&lt;br&gt;1 · une seule instruction, pas deux collées&lt;br&gt;2 · elle commence par SELECT, donc elle lit&lt;br&gt;3 · aucune écriture nulle part, &lt;i&gt;y compris à l&#39;intérieur d&#39;une sous-requête nommée (WITH … AS)&lt;/i&gt;&lt;br&gt;4 · aucune commande de moteur &lt;i&gt;(PRAGMA, ATTACH, VACUUM : elles ne lisent pas des données)&lt;/i&gt;&lt;br&gt;5 · toutes les colonnes figurent dans la matrice, &lt;i&gt;les surnoms de tables (alias) étant d&#39;abord résolus&lt;br&gt;&lt;br&gt;Utilisation de &lt;b&gt;sqlglot&lt;/b&gt;, essai de la requete contre la DB avec &lt;b&gt;EXPLAIN&lt;/b&gt;.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="375" y="784.5" width="405" height="205" as="geometry"/>
                </mxCell>
                <mxCell id="N5" value="&lt;b&gt;N5 · Plafond de lignes&lt;/b&gt;&lt;br/&gt;&lt;i&gt;si la requête ne borne pas son résultat, on ajoute nous-mêmes un LIMIT&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="432.5" y="1051" width="287.5" height="69" as="geometry"/>
                </mxCell>
                <mxCell id="N6" value="&lt;b&gt;N6 · Exécution en lecture seule&lt;/b&gt;&lt;br/&gt;une connexion neuve à chaque requête, et :&lt;br/&gt;· ouverte en lecture seule &lt;i&gt;(mode=ro)&lt;/i&gt;&lt;br/&gt;· verrou interne du moteur &lt;i&gt;(query_only=ON)&lt;/i&gt;&lt;br/&gt;· un délai maximal, au-delà duquel on interrompt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="432.5" y="1154.5" width="285" height="103" as="geometry"/>
                </mxCell>
                <mxCell id="N7" value="&lt;b&gt;N7 · Contrôle du résultat&lt;/b&gt;&lt;br&gt;&lt;i&gt;trois contrôles de code,&lt;br&gt;aucune passe LLM :&lt;br&gt;lignes homonymes · aucune&lt;br&gt;ligne · plafond atteint&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="465" y="1280" width="220" height="115.5" as="geometry"/>
                </mxCell>
                <mxCell id="S1" value="&lt;b&gt;S1 · Réponse&lt;/b&gt;&lt;br/&gt;le résultat, &lt;b&gt;la requête SQL qui l&amp;#x27;a produit&lt;/b&gt;,&lt;br/&gt;et les conventions métier appliquées" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="375" y="1443.5" width="400" height="69" as="geometry"/>
                </mxCell>
                <mxCell id="J" value="&lt;b&gt;J · Journal&lt;/b&gt;&lt;br/&gt;&lt;i&gt;tous les appels y figurent, servis comme refusés.&lt;br/&gt;Journal non écrit = appel non servi : E5 n&amp;#x27;admet pas d&amp;#x27;appel non tracé&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="405" y="1560.5" width="340" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="P5" value="&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;b&gt;P5 · Erreur SQLite sur la requête&lt;/b&gt;&lt;br&gt;&lt;i&gt;colonne ou table inexistante —&amp;gt; le contrôle 5 ne voit que la matrice, pas ce que le modèle invente hors d&#39;elle. La requête est fausse, pas interdite&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCCC;strokeColor=#808080;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=12;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="22" y="1226" width="330" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="P6" value="&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;b&gt;P6 · Base indisponible&lt;/b&gt;&lt;br&gt;&lt;i&gt;fichier absent, ou &lt;b&gt;database is locked&lt;/b&gt; —&amp;gt; journal_mode=delete : un lecteur bloque les écrivains. C&#39;est l&#39;incident du vendredi soir&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCCC;strokeColor=#808080;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=12;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="22" y="1312" width="330" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="A3" value="&lt;b&gt;A3 · Résultat tronqué&lt;/b&gt;&lt;br/&gt;&lt;i&gt;le plafond de lignes est atteint : les lignes existent, ce n&amp;#x27;est pas une erreur. On rend le résultat, le plafond appliqué, et le fait qu&amp;#x27;il en manque&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="865" y="1470" width="310" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="f9" value="plafond&lt;br/&gt;atteint" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#d79b00;jettySize=20;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="N7" target="A3" edge="1">
                    <mxGeometry x="0.2415" relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="795" y="1350.5"/>
                            <mxPoint x="795" y="1508"/>
                        </Array>
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="j10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#999999;endArrow=open;jettySize=20;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="A3" target="J" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1195" y="1508"/>
                            <mxPoint x="1195" y="1603.5"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#808080;jettySize=20;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashPattern=1 2;" parent="1" source="N3" target="P1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#808080;jettySize=20;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashPattern=1 2;" parent="1" source="N4" target="P2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#808080;jettySize=20;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashPattern=1 2;" parent="1" source="N5" target="P3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#808080;jettySize=20;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashPattern=1 2;" parent="1" target="P4" edge="1">
