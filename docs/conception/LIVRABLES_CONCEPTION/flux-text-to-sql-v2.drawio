                <mxCell id="P1" value="&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;&quot;&gt;P1 · Le modèle ne répond pas, ou hors format&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;&quot;&gt;panne, délai dépassé, JSON invalide, zéro ou deux branches remplies —&amp;gt; la sortie imposée n&#39;est pas honorée, il n&#39;y a rien à valider&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCCC;strokeColor=#808080;align=left;spacingLeft=12;spacingRight=10;verticalAlign=middle;fontSize=12;fontColor=#FFFFFF;rotation=0;" parent="1" vertex="1">
