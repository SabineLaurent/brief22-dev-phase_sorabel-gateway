                <mxCell id="DEV" value="&lt;b&gt;IDE des développeurs&lt;/b&gt;&lt;br&gt;chercher &lt;b&gt;sans&lt;/b&gt; générer : il a son propre LLM&lt;br&gt;&lt;i&gt;profil dev &amp;#183; 270 éditions &amp;#183; pas de données&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1">
