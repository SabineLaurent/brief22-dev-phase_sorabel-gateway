    <diagram id="flux-complet-sorabel" name="Flux complet — Sorabel Data Gateway">
        <mxGraphModel dx="2295" dy="2310" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="1780" background="#ffffff" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
