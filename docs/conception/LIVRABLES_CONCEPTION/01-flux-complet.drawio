                <mxCell id="TITRE" value="&lt;b&gt;Flux complet — Sorabel Data Gateway&lt;/b&gt;&lt;br&gt;Le serveur MCP est une &lt;b&gt;barrière&lt;/b&gt;, pas une étape parmi d&#39;autres : les clients sont au-dessus, les ressources en dessous, la mécanique qui régule l&#39;ensemble à l&#39;intérieur.&lt;br&gt;&lt;i&gt;synoptique d&#39;une page — le détail de chaque chantier est dans son propre schéma (cf. encadré en bas)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1540" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="F_CLI" value="CLIENTS — chacun choisit le tool via son propre LLM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fontColor=#666666;fontSize=15;" parent="1" vertex="1">
