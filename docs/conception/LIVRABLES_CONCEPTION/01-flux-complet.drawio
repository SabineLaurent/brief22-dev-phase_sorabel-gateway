                <mxCell id="TOOLS" value="&lt;b&gt;les huit tools&lt;/b&gt; — le paramètre &lt;i&gt;profil&lt;/i&gt; n&#39;apparaît dans aucune signature&lt;br&gt;similarité : &lt;b&gt;answer_question&lt;/b&gt; &amp;#183; &lt;b&gt;search_docs&lt;/b&gt; &amp;#160;&amp;#124;&amp;#160; identité : &lt;b&gt;get_document&lt;/b&gt; &amp;#183; &lt;b&gt;list_sources&lt;/b&gt; &amp;#160;&amp;#124;&amp;#160; SQL : &lt;b&gt;get_schema&lt;/b&gt; &amp;#183; &lt;b&gt;ask_database&lt;/b&gt; &amp;#183; &lt;b&gt;check_stock&lt;/b&gt; &amp;#183; &lt;b&gt;order_status&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
