                <mxCell id="LEG_COUL" value="&lt;b&gt;&lt;u&gt;Les couleurs disent la nature de l&#39;étape&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;gris&lt;/b&gt; source fournie&lt;br&gt;&lt;b&gt;bleu&lt;/b&gt; traitement&lt;font color=&quot;#333333&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;b&gt;vert&lt;/b&gt; barrière de gouvernance&lt;font color=&quot;#333333&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;b&gt;orange&lt;/b&gt; configuration/trace&lt;font color=&quot;#333333&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;b&gt;violet&lt;/b&gt; client&lt;font color=&quot;#333333&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;b&gt;jaune, bordure épaisse&lt;/b&gt; la barrière elle-même = le cadre du serveur MCP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#333333;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="80" y="1630" width="470" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="LEG_TRAIT" value="&lt;b&gt;&lt;u&gt;Les traits disent ce qui circule&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;plein:&lt;/b&gt;&amp;nbsp;la donnée ou l&#39;appel circule&lt;br&gt;&lt;b&gt;pointillé:&lt;/b&gt;&amp;nbsp;une décision, une configuration, une trace : &lt;b&gt;rien de métier n&#39;y circule&lt;/b&gt;&lt;br&gt;&lt;br&gt;Aucun client, aucune source ne se touchent directement : tout passe par la gateway." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#333333;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="570" y="1630" width="470" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="LEG_RENV" value="&lt;u&gt;&lt;b&gt;Pour plus de détails&lt;/b&gt;:&lt;br&gt;&lt;br&gt;&lt;/u&gt;- documentaire → &lt;i&gt;schema-rag-avance.png&lt;/i&gt;&lt;br&gt;- Text-to-SQL → &lt;i&gt;schema&lt;/i&gt;-&lt;i&gt;text-to-sql.png&lt;/i&gt;&lt;br&gt;- les huit tools → &lt;i&gt;catalogue-tools.png&lt;/i&gt;&lt;br&gt;- règle d&#39;accès →&amp;nbsp;&lt;i&gt;matrice-acces.png&lt;/i&gt;&lt;div&gt;&lt;i&gt;&lt;br&gt;&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CCFFFF;strokeColor=#FF0000;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontSize=11;" parent="1" vertex="1">
