        <!-- ====== LEGENDE — en bas de page ====== -->
        <mxCell id="F_LEG" value="COMMENT LIRE CE SCHÉMA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fontColor=#666666;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="1590" width="1540" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="LEG_COUL" value="&lt;b&gt;Les couleurs disent la nature de l'étape&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;gris&lt;/b&gt; source fournie &amp;#183; &lt;b&gt;bleu&lt;/b&gt; traitement &amp;#183; &lt;b&gt;vert&lt;/b&gt; barrière de gouvernance &amp;#183; &lt;b&gt;orange&lt;/b&gt; configuration/trace &amp;#183; &lt;b&gt;violet&lt;/b&gt; client &amp;#183; &lt;b&gt;jaune, bordure épaisse&lt;/b&gt; la barrière elle-même — le cadre du serveur MCP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="1630" width="470" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="LEG_TRAIT" value="&lt;b&gt;Les traits disent ce qui circule&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;plein&lt;/b&gt; — la donnée ou l'appel circule&lt;br&gt;&lt;b&gt;pointillé&lt;/b&gt; — une décision, une configuration, une trace : &lt;b&gt;rien de métier n'y circule&lt;/b&gt;&lt;br&gt;&lt;br&gt;Aucun client, aucune source ne se touchent directement : tout passe par la bande gateway." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="570" y="1630" width="470" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="LEG_RENV" value="&lt;b&gt;Ce synoptique s'arrête au grain de l'étape.&lt;/b&gt; Détail :&lt;br&gt;documentaire &amp;#8594; &lt;i&gt;schema-rag-avance_V2.drawio&lt;/i&gt;&lt;br&gt;Text-to-SQL &amp;#8594; &lt;i&gt;04-chemin-text-to-sql.drawio&lt;/i&gt; (V3)&lt;br&gt;les huit tools &amp;#8594; &lt;i&gt;03-catalogue-tools.drawio&lt;/i&gt;&lt;br&gt;qui a droit à quoi &amp;#8594; &lt;i&gt;05-matrice-acces.drawio&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#333333;fontSize=11;" vertex="1" parent="1">
