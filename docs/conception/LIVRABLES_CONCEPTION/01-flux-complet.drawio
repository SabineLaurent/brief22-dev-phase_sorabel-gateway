                <mxCell id="PROFIL" value="&lt;b&gt;SORABEL_PROFILE&lt;/b&gt;&lt;br&gt;lu dans l&#39;environnement de lancement, transport &lt;b&gt;stdio&lt;/b&gt;&lt;br&gt;&lt;i&gt;le client ne le déclare jamais&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1">
