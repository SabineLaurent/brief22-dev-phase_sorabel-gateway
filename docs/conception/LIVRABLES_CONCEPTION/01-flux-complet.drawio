<mxfile host="app.diagrams.net" type="device">
  <diagram id="flux-complet-sorabel" name="Flux complet — Sorabel Data Gateway">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="1780" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <!-- ====== TITRE ====== -->
        <mxCell id="TITRE" value="&lt;b&gt;Flux complet — Sorabel Data Gateway&lt;/b&gt;&lt;br&gt;Le serveur MCP est une &lt;b&gt;barrière&lt;/b&gt;, pas une étape parmi d'autres : les clients sont au-dessus, les ressources en dessous, la mécanique qui régule l'ensemble à l'intérieur.&lt;br&gt;&lt;i&gt;synoptique d'une page — le détail de chaque chantier est dans son propre schéma (cf. encadré en bas)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1540" height="62" as="geometry"/>
        </mxCell>
        <!-- ====== CADRE CLIENTS (haut) ====== -->
        <mxCell id="F_CLI" value="CLIENTS — chacun choisit le tool via son propre LLM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fontColor=#666666;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1540" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="SUP" value="&lt;b&gt;bot Slack du support&lt;/b&gt;&lt;br&gt;une réponse prête, sourcée&lt;br&gt;&lt;i&gt;profil support &amp;#183; 318 éditions&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="140" y="140" width="400" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="COM" value="&lt;b&gt;poste des commerciaux&lt;/b&gt;&lt;br&gt;une réponse prête, et des chiffres&lt;br&gt;&lt;i&gt;profil commercial &amp;#183; 350 éditions&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="140" width="400" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="DEV" value="&lt;b&gt;IDE des développeurs&lt;/b&gt;&lt;br&gt;chercher &lt;b&gt;sans&lt;/b&gt; générer : il a son propre LLM&lt;br&gt;&lt;i&gt;profil dev &amp;#183; 270 éditions &amp;#183; pas de données&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="140" width="400" height="80" as="geometry"/>
        </mxCell>
        <!-- ====== CADRE GATEWAY (milieu) — LA barriere, bordure epaisse ====== -->
        <mxCell id="F_GATE" value="SERVEUR MCP — SORABEL DATA GATEWAY — barrière unique, révision 2026-07-28" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6b656;strokeWidth=4;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=16;fontColor=#7a6220;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="1540" height="1090" as="geometry"/>
        </mxCell>
        <!-- ====== GATEWAY — rangee 1 : profil, etages, matrice ====== -->
        <mxCell id="PROFIL" value="&lt;b&gt;SORABEL_PROFILE&lt;/b&gt;&lt;br&gt;lu dans l'environnement de lancement, transport &lt;b&gt;stdio&lt;/b&gt;&lt;br&gt;&lt;i&gt;le client ne le déclare jamais&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="320" width="460" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="ETAGES" value="&lt;b&gt;3 étages d'autorisation&lt;/b&gt;&lt;br&gt;1 &amp;#183; &lt;i&gt;tools/list&lt;/i&gt; filtré &amp;#8594; ergonomie&lt;br&gt;2 &amp;#183; intercepteur d'entrée &amp;#8594; garantie&lt;br&gt;3 &amp;#183; dans le tool &amp;#8594; garantie, seul endroit où E5 est vérifiable" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="570" y="320" width="460" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="MATRICE" value="&lt;b&gt;matrice.yaml&lt;/b&gt;&lt;br&gt;&lt;i&gt;autoriser(profil, ressource)&lt;/i&gt;&lt;br&gt;tools &amp;#183; collections+thèmes &amp;#183; tables+colonnes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1060" y="320" width="480" height="90" as="geometry"/>
        </mxCell>
        <!-- ====== GATEWAY — rangee 2 : les deux machineries, cote a cote ====== -->
        <mxCell id="F_DOCM" value="machinerie — retrieval documentaire" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fontColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="435" width="720" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="F_SQLM" value="machinerie — text-to-sql" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fontColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="820" y="435" width="720" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="FILTRE" value="&lt;b&gt;filtre d'index par profil&lt;/b&gt;&lt;br&gt;disjonction, jamais conjonction&lt;br&gt;350 commercial &amp;#183; 318 support &amp;#183; 270 dev" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="110" y="475" width="660" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="HYB" value="&lt;b&gt;BM25 ∥ dense&lt;/b&gt; — lexical et sémantique, en parallèle" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="110" y="555" width="660" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="RRF" value="&lt;b&gt;fusion RRF, k = 60&lt;/b&gt; — des rangs, jamais des scores" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="110" y="615" width="660" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="RERANK" value="&lt;b&gt;rerank cross-encoder&lt;/b&gt; — lit la paire question + chunk" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="110" y="675" width="660" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="BARR" value="&lt;b&gt;2 barrières de refus&lt;/b&gt; (E1) — seuil du reranker &amp;#8594; &lt;i&gt;hors_corpus&lt;/i&gt; &amp;#183; suffisance LLM &amp;#8594; &lt;i&gt;contexte_insuffisant&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="110" y="731" width="660" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="CONTRAT" value="&lt;b&gt;contrat de lecture&lt;/b&gt;&lt;br&gt;DDL filtré, énumérations, plage, conventions — sert aussi &lt;i&gt;get_schema&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="850" y="475" width="660" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="PASSE" value="&lt;b&gt;1 passe LLM&lt;/b&gt;, sortie structurée : sql &amp;#124; clarification &amp;#124; refus" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="850" y="555" width="660" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="ASTV" value="&lt;b&gt;validation d'AST&lt;/b&gt; — sqlglot, 5 contrôles sur la structure, pas sur le texte" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="850" y="615" width="660" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="EXEC" value="&lt;b&gt;exécution en lecture seule&lt;/b&gt; — connexion neuve, mode=ro + query_only=ON, LIMIT, timeout" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="850" y="675" width="660" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="NOTE_T1" value="réponse = résultat + &lt;b&gt;la requête SQL qui l'a produit&lt;/b&gt; (T1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#333333;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="731" width="660" height="26" as="geometry"/>
        </mxCell>
        <!-- ====== GATEWAY — rangee 3 : tools ====== -->
        <mxCell id="TOOLS" value="&lt;b&gt;les huit tools&lt;/b&gt; — le paramètre &lt;i&gt;profil&lt;/i&gt; n'apparaît dans aucune signature&lt;br&gt;similarité : &lt;b&gt;answer_question&lt;/b&gt; &amp;#183; &lt;b&gt;search_docs&lt;/b&gt; &amp;#160;&amp;#124;&amp;#160; identité : &lt;b&gt;get_document&lt;/b&gt; &amp;#183; &lt;b&gt;list_sources&lt;/b&gt; &amp;#160;&amp;#124;&amp;#160; SQL : &lt;b&gt;get_schema&lt;/b&gt; &amp;#183; &lt;b&gt;ask_database&lt;/b&gt; &amp;#183; &lt;b&gt;check_stock&lt;/b&gt; &amp;#183; &lt;b&gt;order_status&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="800" width="1460" height="60" as="geometry"/>
        </mxCell>
        <!-- ====== GATEWAY — rangee 4 : journal ====== -->
        <mxCell id="JOURNAL" value="&lt;b&gt;journal JSONL&lt;/b&gt;, append-only &amp;#8212; un événement par appel, &lt;b&gt;servi comme refusé&lt;/b&gt;&lt;br&gt;ts &amp;#183; profil &amp;#183; tool &amp;#183; decision &amp;#183; &lt;b&gt;etage&lt;/b&gt; &amp;#183; code &amp;#183; sql &amp;#183; citations &amp;#183; latency_ms&lt;br&gt;&lt;i&gt;journal non écrit = appel non servi&lt;/i&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="890" width="1460" height="90" as="geometry"/>
        </mxCell>
        <!-- ====== GATEWAY — note interne ====== -->
        <mxCell id="NOTE_GATE" value="&lt;b&gt;Rien ne traverse cette bande sans passer par elle.&lt;/b&gt; Un client n'atteint jamais directement le corpus ou la base ; la matrice n'est pas consultée, elle est &lt;b&gt;incontournable&lt;/b&gt; — elle borne le filtre d'index, le contrat de lecture, et l'autorisation d'appel, en trois points distincts de cette même bande." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="995" width="1460" height="60" as="geometry"/>
        </mxCell>
