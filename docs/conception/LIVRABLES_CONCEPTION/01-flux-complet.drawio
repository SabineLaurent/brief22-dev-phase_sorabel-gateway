                </mxCell>
                <mxCell id="NOTE_GATE" value="&lt;b&gt;Rien ne traverse cette bande sans passer par elle.&lt;/b&gt; Un client n&#39;atteint jamais directement le corpus ou la base ; la matrice n&#39;est pas consultée, elle est &lt;b&gt;incontournable&lt;/b&gt; — elle borne le filtre d&#39;index, le contrat de lecture, et l&#39;autorisation d&#39;appel, en trois points distincts de cette même bande." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#333333;fontSize=11;" parent="1" vertex="1">
