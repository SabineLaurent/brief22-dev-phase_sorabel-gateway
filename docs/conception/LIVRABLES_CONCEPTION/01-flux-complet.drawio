                <mxCell id="JOURNAL" value="&lt;b&gt;journal JSONL&lt;/b&gt;, append-only &amp;#8212; un événement par appel, &lt;b&gt;servi comme refusé&lt;/b&gt;&lt;br&gt;ts &amp;#183; profil &amp;#183; tool &amp;#183; decision &amp;#183; &lt;b&gt;etage&lt;/b&gt; &amp;#183; code &amp;#183; sql &amp;#183; citations &amp;#183; latency_ms&lt;br&gt;&lt;i&gt;journal non écrit = appel non servi&lt;/i&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="1" vertex="1">
