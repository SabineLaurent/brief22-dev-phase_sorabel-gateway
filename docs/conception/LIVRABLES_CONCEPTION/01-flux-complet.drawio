                <mxCell id="F_LEG" value="LÉGENDES:" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fontColor=#666666;fontSize=15;" parent="1" vertex="1">
