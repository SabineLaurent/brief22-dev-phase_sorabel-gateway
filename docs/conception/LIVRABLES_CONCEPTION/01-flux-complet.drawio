                <mxCell id="SUP" value="&lt;b&gt;bot Slack du support&lt;/b&gt;&lt;br&gt;une réponse prête, sourcée&lt;br&gt;&lt;i&gt;profil support &amp;#183; 318 éditions&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1">
