        <mxCell id="e_contrat_base" value="DDL seul, jamais de lignes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#999999;dashed=1;endArrow=open;endFill=0;fontSize=11;fontColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="CONTRAT" target="BASE">
