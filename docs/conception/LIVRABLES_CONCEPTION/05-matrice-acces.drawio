                <mxCell id="EXCL" value="&lt;b&gt;Toujours fermées, aux quatre profils&lt;/b&gt; — clients.email (RGPD, hors E5) &amp;#183; stocks.id, ventes.id (AUTOINCREMENT sans usage métier, exclues de la liste blanche)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#333333;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1619" width="1600" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="ETAGES" value="&lt;b&gt;Trois étages d&#39;application, dont deux sont des garanties&lt;/b&gt;&lt;br&gt;1 &amp;#183; tools/list filtré — ergonomie, quels tools le client voit&lt;br&gt;2 &amp;#183; intercepteur d&#39;entrée — garantie, ce profil a-t-il ce tool ?&lt;br&gt;3 &amp;#183; dans le tool — &lt;b&gt;garantie, seul endroit où E5 est vérifiable&lt;/b&gt; : ces collections, thèmes, tables, colonnes ?&lt;br&gt;&lt;i&gt;l&#39;étage 3 ne fait aucune hypothèse sur l&#39;étage 2 &amp;#183; le grain documentaire est le thème, pas la collection &amp;#183; dev porte le périmètre de tables du support pour alimenter get_schema seul : un périmètre non vide n&#39;implique pas un accès aux données&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="1" vertex="1">
