<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="Protocole de mesure" id="protocole-mesure">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Titre -->
        <mxCell id="title" value="Protocole de mesure — eval/protocole-mesure.md (chantier RAG, étape 3 : hybride BM25+RRF+rerank)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="1600" height="30" as="geometry" />
        </mxCell>

        <!-- Encart : les 4 drapeaux -->
        <mxCell id="legend" value="Les 4 drapeaux orthogonaux&#10;&#10;--text : clean (défaut) · raw — texte indexé&#10;--config : A (dense) · B (BM25) · C (BM25+dense+RRF+rerank)&#10;--version-filter : on (défaut) · off — is_current avant troncature&#10;--tiebreak : on · off — fiche technique devant notice, fenêtre = 3&#10;&#10;Décision : un seul drapeau varie par mesure." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="560" height="190" as="geometry" />
        </mxCell>

        <!-- Encart : ce qui ne varie pas -->
        <mxCell id="fixed" value="Ce qui ne varie pas&#10;&#10;Corpus : data/corpus/, 400 éditions&#10;Jeu de questions : eval/questions_rag.jsonl, 30&#10;(8 reference_exacte + 14 couverte + 8 hors_corpus)&#10;Profil d'accès : commercial&#10;Versions figées : pypdf, modèle d'embeddings, reranker&#10;Graine et ordre de parcours du corpus&#10;Comptage : par question, pas par référence" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="630" y="40" width="560" height="190" as="geometry" />
        </mxCell>

        <!-- Encart : contraintes -->
        <mxCell id="constraints" value="Contraintes&#10;&#10;• Aucune mesure ne fait varier plus d'un drapeau à la fois&#10;• Rejouer la config A après C, pas seulement avant&#10;• is_current s'applique dans chaque liste avant troncature,&#10;  jamais après la fusion RRF&#10;• Appel direct à eval_rag.py (exploration) → eval/resultats/adhoc-*.csv ;&#10;  seule une cible make écrit sous son propre nom" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;size=16;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1220" y="40" width="560" height="190" as="geometry" />
        </mxCell>

        <!-- Ingestion -->
        <mxCell id="ingestion_label" value="Ingestion" style="text;html=1;fontSize=14;fontStyle=1+4;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="corpus" value="data/corpus/&#10;400 éditions (fixe)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ingest" value="make ingest&#10;--text clean" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="260" y="265" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="coll_clean" value="Collection Chroma&#10;sorabel_corpus" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="520" y="265" width="220" height="45" as="geometry" />
        </mxCell>
        <mxCell id="ingest_brut" value="make ingest-brut&#10;--text raw" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="260" y="340" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="coll_raw" value="Collection Chroma&#10;sorabel_corpus_raw" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="520" y="340" width="220" height="45" as="geometry" />
        </mxCell>

        <!-- Axe 1 -->
        <mxCell id="axe1_label" value="Axe 1 — la recherche, à ingestion constante (= E6, l'exigence du brief)" style="text;html=1;fontSize=14;fontStyle=1+4;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="900" height="20" as="geometry" />
        </mxCell>
        <mxCell id="m_dense" value="make mesure-dense&#10;config A · clean · filtre on&#10;dense seul — « l'avant »&#10;→ eval/resultats/mesure-dense.csv" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="m_lexical" value="make mesure-lexical&#10;config B · clean · filtre on&#10;BM25 seul — « le témoin »&#10;→ eval/resultats/mesure-lexical.csv" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="370" y="450" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="m_hybride" value="make mesure-hybride&#10;config C · clean · filtre on&#10;BM25+dense+RRF+rerank — « l'après »&#10;→ eval/resultats/mesure-hybride.csv" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="700" y="450" width="300" height="120" as="geometry" />
        </mxCell>

        <!-- Axe 2 -->
        <mxCell id="axe2_label" value="Axe 2 — l'ingestion, à recherche constante (config C fixée)" style="text;html=1;fontSize=14;fontStyle=1+4;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="800" height="20" as="geometry" />
        </mxCell>
        <mxCell id="m_sn" value="make mesure-sans-nettoyage&#10;config C · raw · filtre on&#10;→ eval/resultats/mesure-sans-nettoyage.csv" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
