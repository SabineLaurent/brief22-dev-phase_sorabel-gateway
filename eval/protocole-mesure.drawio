        <mxCell id="e_lexical_hybride" value="sans B, le gain attribué à l'hybride&#10;inclut celui de BM25 seul" style="rounded=0;html=1;" edge="1" parent="1" source="m_lexical" target="m_hybride">
          <mxGeometry relative="1" as="geometry" />
