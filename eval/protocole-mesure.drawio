        </mxCell>
        <mxCell id="m_rs" value="make mesure-rag-simple&#10;config A · raw · filtre off · départage off&#10;« RAG simple »&#10;→ eval/resultats/mesure-rag-simple.csv" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="830" width="320" height="120" as="geometry" />
