        <mxCell id="e_seuil_hybride" value="étape 3 : seuil du reranker&#10;(pas encore câblé)" style="dashed=1;html=1;endArrow=block;strokeColor=#d79b00;" edge="1" parent="1" source="seuil" target="m_hybride">
