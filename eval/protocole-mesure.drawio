        </mxCell>
        <mxCell id="m_sv" value="make mesure-sans-versions&#10;config C · clean · filtre off&#10;→ eval/resultats/mesure-sans-versions.csv" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="390" y="640" width="300" height="120" as="geometry" />
        </mxCell>

        <!-- Ligne parlante -->
        <mxCell id="ligne_label" value="Ligne parlante — jamais en remplacement des deux axes" style="text;html=1;fontSize=14;fontStyle=1+4;align=left;verticalAlign=middle;" vertex="1" parent="1">
