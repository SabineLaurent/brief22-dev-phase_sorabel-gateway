        </mxCell>
        <mxCell id="q_calib" value="eval/questions_calibration.jsonl&#10;14 questions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="780" y="830" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="calibrer" value="make calibrer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1080" y="830" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="seuil" value="seuil de refus&#10;(0,831 aujourd'hui)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1300" y="830" width="240" height="55" as="geometry" />
        </mxCell>

        <!-- Orchestration -->
        <mxCell id="orch_label" value="Orchestration et sortie" style="text;html=1;fontSize=14;fontStyle=1+4;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1000" width="400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="make_mesure" value="make mesure&#10;(orchestrateur : rejoue les sept cibles)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="300" y="1030" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="rapport" value="eval/rapport_gain.md&#10;(réécrit intégralement à chaque run)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="660" y="1030" width="340" height="70" as="geometry" />
        </mxCell>

        <!-- Flèches ingestion -->
        <mxCell id="e_corpus_ingest" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="corpus" target="ingest">
