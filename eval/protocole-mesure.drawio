        <mxCell id="e_sv_hybride" value="effet du versionnement" style="dashed=1;html=1;endArrow=block;startArrow=block;" edge="1" parent="1" source="m_sv" target="m_hybride">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Ligne parlante -->
        <mxCell id="e_rs_hybride" value="toujours accompagnée de sa décomposition" style="dashed=1;html=1;endArrow=block;startArrow=block;" edge="1" parent="1" source="m_rs" target="m_hybride">
          <mxGeometry relative="1" as="geometry" />
