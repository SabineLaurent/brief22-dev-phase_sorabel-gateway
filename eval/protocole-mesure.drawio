        <mxCell id="e_ingestbrut_collraw" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="ingest_brut" target="coll_raw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Flèches Axe 1 -->
        <mxCell id="e_coll_dense" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.3;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="coll_clean" target="m_dense">
          <mxGeometry relative="1" as="geometry" />
