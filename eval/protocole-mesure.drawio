        <mxCell id="e_ingest_coll" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="ingest" target="coll_clean">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_corpus_ingestbrut" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="corpus" target="ingest_brut">
          <mxGeometry relative="1" as="geometry" />
