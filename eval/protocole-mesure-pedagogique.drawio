<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="Protocole de mesure — version simple" id="protocole-mesure-pedagogique">
    <mxGraphModel dx="1300" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Pourquoi ajouter mots-clés et reclassement à la recherche ? (version simple)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="1200" height="30" as="geometry" />
        </mxCell>

        <mxCell id="intro" value="Une recherche par le sens des mots ne suffit pas toujours à retrouver le bon document.&#10;On compare trois façons de chercher, dans les mêmes conditions, pour savoir ce qui marche vraiment." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1200" height="70" as="geometry" />
        </mxCell>

        <!-- Escalier : 3 façons de chercher, en langage clair -->
        <mxCell id="step1" value="Recherche par le sens&#10;(embeddings)&#10;&#10;Compare la question au sens du texte.&#10;C'est le point de départ.&#10;&#10;make mesure-dense" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="step2" value="+ Recherche par mots-clés&#10;(BM25)&#10;&#10;Ajoutée à part, pour vérifier son effet&#10;séparément — c'est le témoin.&#10;&#10;make mesure-lexical" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="440" y="160" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="step3" value="+ Fusion des deux, puis reclassement&#10;(RRF, puis rerank)&#10;&#10;Combine les deux recherches, puis un&#10;modèle reclasse les meilleurs résultats.&#10;&#10;make mesure-hybride" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="840" y="160" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="e_step1_2" value="s'ajoute à" style="html=1;fontSize=11;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_step2_3" value="s'ajoute à" style="html=1;fontSize=11;" edge="1" parent="1" source="step2" target="step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Ce qui ne change jamais -->
        <mxCell id="fixed" value="Ce qui reste identique pendant la comparaison : le même corpus, les mêmes questions, le même profil d'accès — pour que seule la façon de chercher change." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="1180" height="60" as="geometry" />
        </mxCell>

        <!-- Résultat mesuré -->
        <mxCell id="result_label" value="Résultat mesuré (Hit@1 : la bonne référence trouvée en premier)" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="800" height="24" as="geometry" />
        </mxCell>
        <mxCell id="res1" value="Recherche par le sens seule&#10;&#10;2 / 8" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="454" width="340" height="130" as="geometry" />
        </mxCell>
        <mxCell id="res2" value="+ mots-clés (témoin)&#10;&#10;3 / 8" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="440" y="454" width="340" height="130" as="geometry" />
        </mxCell>
        <mxCell id="res3" value="+ fusion + reclassement&#10;&#10;8 / 8&#10;MRR 1,000" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="454" width="380" height="130" as="geometry" />
        </mxCell>

        <!-- Renvoi vers le schéma complet -->
        <mxCell id="note_full" value="Deux mesures complémentaires existent aussi côté ingestion (effet du nettoyage du texte, effet du filtrage des versions).&#10;Détail complet des sept cibles et des quatre drapeaux : eval/protocole-mesure.drawio" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="1180" height="70" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
