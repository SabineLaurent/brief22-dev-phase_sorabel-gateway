# Copier vers .env et ajuster si besoin. Aucune valeur ci-dessous n'est un secret réel.

# Base vectorielle (docker compose expose Chroma sur 8002)
CHROMA_URL=http://localhost:8002

# Collection Chroma du corpus documentaire
CHROMA_COLLECTION=sorabel_corpus

# Modèle d'embeddings local (sentence-transformers via l'extra [vector]).
# Utilisé quand aucun déploiement Azure n'est configuré ci-dessous.
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Inférence Azure AI Foundry, en OpenAI-compatible (API v1 : pas d'api_version).
# Laisser AZURE_EMBEDDING_DEPLOYMENT vide pour garder le modèle local ci-dessus.
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
# Modèle de chat appelé par l'agent conversationnel (packages/agent/cli.py) ;
# aucune fonction du RAG lui-même n'en dépend.
LLM_CHAT_MODEL=
AZURE_EMBEDDING_DEPLOYMENT=

# Recherche documentaire
SEARCH_TOP_K=5
# Score minimal du premier résultat sous lequel la recherche refuse (hors_corpus).
# Calibré par `make calibrer` sur eval/questions_calibration.jsonl — jamais sur le
# jeu de mesure. Vider la valeur désactive la barrière.
REFUSAL_THRESHOLD=0.8308

# Recherche hybride (étape 3) : profondeur des listes avant fusion RRF et rerank.
RERANK_CANDIDATES=20

# Reranker local (extra [vector]), utilisé quand AZURE_RERANK_DEPLOYMENT est vide.
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Renseigné ⇒ le rerank part sur Azure AI Foundry (API v1) en LLM-juge, au lieu du
# cross-encoder local. Réutilise AZURE_AI_ENDPOINT / AZURE_AI_API_KEY ci-dessus.
AZURE_RERANK_DEPLOYMENT=

# Score minimal du premier résultat, échelle du reranker — critère de refus de la
# configuration hybride. Calibré par `make calibrer-hybride`.
RERANK_THRESHOLD=0.0530

# Base SQL Sorabel (SQLite, générée par `make seed`)
SORABEL_DB=data/sorabel.db

# Journal des appels de la gateway
GATEWAY_JOURNAL=logs/journal.jsonl

# Profil client par défaut du serveur MCP (support | commercial)
SORABEL_PROFILE=support
