# Copier vers .env et ajuster si besoin. Aucune valeur ci-dessous n'est un secret réel.

# Base vectorielle (docker compose expose Chroma sur 8002)
CHROMA_URL=http://localhost:8002

# Collection Chroma du corpus documentaire
CHROMA_COLLECTION=sorabel_corpus

# Modèle d'embeddings local (sentence-transformers via l'extra [vector]).
# Utilisé quand aucun déploiement Azure n'est configuré ci-dessous.
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Inférence Azure AI Foundry, en OpenAI-compatible (API v1 : pas d'api_version).
# Laisser AZURE_EMBEDDING_DEPLOYMENT vide pour garder le modèle local ci-dessus.
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
# Modèle de chat appelé par l'agent conversationnel (packages/agent/cli.py) ;
# aucune fonction du RAG lui-même n'en dépend.
LLM_CHAT_MODEL=
AZURE_EMBEDDING_DEPLOYMENT=

# Recherche documentaire
SEARCH_TOP_K=5
# Score minimal du premier résultat sous lequel la recherche refuse (hors_corpus).
# Calibré par `make calibrer` sur eval/questions_calibration.jsonl — jamais sur le
# jeu de mesure. Vider la valeur désactive la barrière.
# ATTENTION : cette valeur appartient à un modèle ET à un index — 0,8308 vaut pour
# `intfloat/multilingual-e5-base` sur la collection `sorabel_corpus`. Changer
# EMBEDDING_MODEL ou AZURE_EMBEDDING_DEPLOYMENT sans recalibrer règle le refus sur
# une distribution de scores étrangère, sans le moindre message.
REFUSAL_THRESHOLD=0.8308

# Recherche hybride (étape 3) : profondeur des listes avant fusion RRF et rerank.
RERANK_CANDIDATES=20

# Reranker local (extra [vector]) : le défaut, et le repli.
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Reranker déployé sur Azure AI Foundry (Cohere) : un VRAI reranker, qui rend un score
# de pertinence par document. Son API n'est pas OpenAI-compatible et il ne réutilise
# donc rien du bloc d'inférence ci-dessus : POST {endpoint}/v2/rerank, avec son endpoint
# et sa clé propres.
# LA RÈGLE EST TOUT OU RIEN : les TROIS variables renseignées ⇒ Cohere. Une seule vide
# ⇒ c'est RERANKER_MODEL ci-dessus qui est utilisé. Pas de configuration à moitié : un
# reranker à moitié configuré doit retomber sur un défaut qui marche, jamais échouer à
# la première question.
# AZURE_RERANK_ENDPOINT est l'URL COMPLÈTE de l'appel, pas une base — et ce n'est pas
# celle qu'affiche le champ « point de terminaison » du panneau de déploiement (qui rend
# 404 sur le rerank), mais celle du DÉTAIL du déploiement. Elle ressemble à :
#   https://<ressource>.services.ai.azure.com/providers/cohere/v2/rerank
# Exemple de déploiement au catalogue : Cohere-rerank-v4.0-fast (ou -pro).
AZURE_RERANK_DEPLOYMENT=
AZURE_RERANK_ENDPOINT=
AZURE_RERANK_API_KEY=

# Score minimal du premier résultat, échelle du reranker — critère de refus de la
# configuration hybride. Calibré par `make calibrer-hybride`.
# ATTENTION : cette valeur est propre au cross-encoder `mmarco-mMiniLMv2-L12-H384-v1`.
# Chaque reranker a sa propre échelle de scores — changer de reranker impose de
# recalibrer, sinon le seuil mesure autre chose que ce qu'il prétend.
RERANK_THRESHOLD=0.0530

# Base SQL Sorabel (SQLite, générée par `make seed`)
SORABEL_DB=data/sorabel.db

# Journal des appels de la gateway
GATEWAY_JOURNAL=logs/journal.jsonl

# Profil client par défaut du serveur MCP (support | commercial)
SORABEL_PROFILE=support
